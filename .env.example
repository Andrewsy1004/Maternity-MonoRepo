# Puerto HTTP de Nginx. Elegido para no usar los puertos 3000, 5433, 8080 ni 8081.
APP_PORT=8082

# URL pública sin barra final. Cambia IP por dominio antes de desplegar con TLS.
PUBLIC_API_URL=http://IP_DE_TU_VPS:8082

POSTGRES_USER=gmi
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
POSTGRES_DB=gmi_db
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret
OPENAI_API_KEY=replace_with_your_openai_api_key

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
